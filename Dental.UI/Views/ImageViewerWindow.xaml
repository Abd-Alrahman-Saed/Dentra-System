<Window x:Class="Dental.UI.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        Background="#CC000000"
        AllowsTransparency="True"
        KeyDown="Window_KeyDown"
        Focusable="True">
        

    <Grid Focusable="True">

        <Border x:Name="ImageContainer"
        Margin="90,70"
        ClipToBounds="True"
        Cursor="Arrow"
        MouseWheel="ImageContainer_MouseWheel"
        MouseLeftButtonDown="Image_MouseDown"
        MouseLeftButtonUp="Image_MouseUp"
        MouseMove="Image_MouseMove">

            <Image x:Name="PreviewImage"
           Stretch="Uniform"
           RenderTransformOrigin="0.5,0.5">

                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScaleTransform"
                                ScaleX="1"
                                ScaleY="1"/>
                        <TranslateTransform x:Name="ImageTranslateTransform"
                                    X="0"
                                    Y="0"/>
                    </TransformGroup>
                </Image.RenderTransform>

            </Image>
        </Border>
        
        <Button Content="‹"
                Width="60"
                Height="80"
                FontSize="55"
                Background="#66000000"
                Foreground="White"
                BorderThickness="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="20,0,0,0"
                Cursor="Hand"
                Click="Previous_Click"/>

        <Button Content="›"
                Width="60"
                Height="80"
                FontSize="55"
                Background="#66000000"
                Foreground="White"
                BorderThickness="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,20,0"
                Cursor="Hand"
                Click="Next_Click"/>

        <TextBlock x:Name="CounterTextBlock"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,24,0,0"/>

        <Button Content="✕"
                Width="44"
                Height="44"
                FontSize="20"
                Background="#66000000"
                Foreground="White"
                BorderThickness="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="20"
                Cursor="Hand"
                Click="Close_Click"/>

    </Grid>
</Window>