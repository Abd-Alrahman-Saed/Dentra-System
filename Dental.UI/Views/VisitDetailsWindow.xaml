<Window x:Class="Dental.UI.Views.VisitDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visit Details"
        Width="900"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <Button Content="←"
                FontSize="34"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#0F172A"
                Cursor="Hand"
                Click="BackButton_Click"/>

            <TextBlock x:Name="VisitTitleTextBlock"
                   Grid.Column="1"
                   Text="Visit 2"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#0F172A"
                   VerticalAlignment="Center"/>

            <TextBlock x:Name="VisitDateTextBlock"
                   Grid.Column="2"
                   Text="📅 20 Feb 2026"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#334155"
                   VerticalAlignment="Center"/>

            <Button Grid.Column="3"
                Content="⋮"
                FontSize="28"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#0F172A"
                Cursor="Hand">
                <Button.ContextMenu>
                    <ContextMenu Background="White"
             BorderBrush="#E2E8F0"
             BorderThickness="1"
             Padding="6">

                        <MenuItem Click="DeleteVisitMenuItem_Click">
                            <MenuItem.Template>
                                <ControlTemplate TargetType="MenuItem">
                                    <Border x:Name="Border"
                        Background="Transparent"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="2">

                                        <StackPanel Orientation="Horizontal">
                                            <!-- Icon -->
                                            <Border Width="32"
                                Height="32"
                                Background="#FEE2E2"
                                CornerRadius="6"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">

                                                <TextBlock Text="🗑"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="16"/>
                                            </Border>

                                            <!-- Text -->
                                            <TextBlock Text="Delete Visit"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#B91C1C"
                                   VerticalAlignment="Center"/>
                                        </StackPanel>

                                    </Border>

                                    <!-- Hover Effect -->
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#FEF2F2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </MenuItem.Template>
                        </MenuItem>

                    </ContextMenu>
                </Button.ContextMenu>

                <Button.Style>
                    <Style TargetType="Button">
                        <EventSetter Event="Click" Handler="MoreButton_Click"/>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="#E5E7EB"/>

        <!-- Scroll Content -->
        <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,18,8,0">

            <StackPanel>

                <!-- Notes Header -->
                <Grid Margin="10,0,0,10">
                    <TextBlock Text="Description / Notes"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#0B73E8"/>

                    <Button x:Name="EditNotesButton"
                        Content="Edit"
                        HorizontalAlignment="Right"
                        Margin="0,0,20,0"
                        FontSize="17"
                        FontWeight="Bold"
                        Foreground="#0B73E8"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="EditNotesButton_Click"/> 
                </Grid>

                <!-- Notes Box -->
                <Border BorderBrush="#E5E7EB"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="18"
                    MinHeight="150"
                    Margin="10,0,0,10">

                    <Grid>
                        <TextBlock x:Name="NotesTextBlock"
                            Text="Notes here"
                            FontSize="17"
                            Foreground="#1E293B"
                            TextWrapping="Wrap"
                            LineHeight="27"/>

                        <TextBox x:Name="NotesTextBox"
                             Visibility="Collapsed"
                             FontSize="17"
                             Foreground="#1E293B"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>

                <!-- Save / Cancel Buttons -->
                <StackPanel x:Name="EditNotesActionsPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,20,20"
                    Visibility="Collapsed">

                    <Button Content="Save"
                        Width="90"
                        Height="36"
                        Margin="0,0,10,0"
                        Background="#0B73E8"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SaveNotesButton_Click"/>

                    <Button Content="Cancel"
                        Width="90"
                        Height="36"
                        Background="#E5E7EB"
                        Foreground="#0F172A"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CancelNotesButton_Click"/>
                </StackPanel>

                <!-- Clinical Photos -->
                <Grid Margin="10,0,0,12">
                    <TextBlock Text="Clinical Photos  ⓘ"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#0B73E8"/>

                    <Button Content="Upload"
                        HorizontalAlignment="Right"
                        FontSize="17"
                        FontWeight="Bold"
                        Foreground="#0B73E8"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,20, 0"
                        Click="UploadClinical_Click"/>
                </Grid>

                <ItemsControl x:Name="ClinicalImagesItemsControl"
                          Margin="10,0,0,18">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="115"
                                Margin="10,0,14,14"
                                CornerRadius="8"
                                ClipToBounds="True"
                                Background="#E5E7EB">
                                <Image Source="{Binding Source}"
                                   Stretch="UniformToFill"
                                   Cursor="Hand"
                                   MouseLeftButtonDown="Image_DoubleClick">

                                    <Image.ContextMenu>
                                        <ContextMenu Background="White"
                                             BorderBrush="#E2E8F0"
                                             BorderThickness="1"
                                             Padding="6">

                                            <MenuItem Click="DeleteImageMenuItem_Click"
                                                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">

                                                <MenuItem.Template>
                                                    <ControlTemplate TargetType="MenuItem">
                                                        <Border x:Name="Border"
                                                            Background="Transparent"
                                                            CornerRadius="8"
                                                            Padding="14,10"
                                                            Margin="2">

                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="30"
                                                                    Height="30"
                                                                    Background="#FEE2E2"
                                                                    CornerRadius="6"
                                                                    Margin="0,0,10,0">

                                                                    <TextBlock Text="🗑"
                                                                       FontSize="15"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                                </Border>

                                                                <TextBlock Text="Delete Image"
                                                                    FontSize="16"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#B91C1C"
                                                                    VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="Border"
                                                                    Property="Background"
                                                                    Value="#FEF2F2"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </MenuItem.Template>

                                            </MenuItem>

                                        </ContextMenu>
                                    </Image.ContextMenu>
                                </Image>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Xray Images -->
                <Grid Margin="10,0,0,12">
                    <TextBlock Text="X-ray Images     ⓘ"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#0B73E8"/>

                    <Button Content="Upload"
                        HorizontalAlignment="Right"
                        FontSize="17"
                        FontWeight="Bold"
                        Foreground="#0B73E8"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,20, 0"
                        Click="UploadXray_Click"/>
                </Grid>

                <ItemsControl x:Name="XrayImagesItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="115"
                                Margin="10,0,14,14"
                                CornerRadius="8"
                                ClipToBounds="True"
                                Background="#E5E7EB">

                                <Border.ContextMenu>
                                    <ContextMenu Padding="6"
                                         Background="White"
                                         BorderBrush="#E2E8F0"
                                         BorderThickness="1">

                                        <MenuItem Click="DeleteImageMenuItem_Click"
                                            CommandParameter="{Binding}">

                                            <MenuItem.Template>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="Border"
                                                        Background="Transparent"
                                                        CornerRadius="8"
                                                        Padding="12,8"
                                                        Margin="2">

                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🗑"
                                                               FontSize="16"
                                                               Margin="0,0,8,0"/>

                                                            <TextBlock Text="Delete Image"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="#B91C1C"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="Border"
                                                                Property="Background"
                                                                Value="#FEF2F2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </MenuItem.Template>

                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Image Source="{Binding Source}"
                                    Stretch="UniformToFill"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="Image_DoubleClick">

                                    <Image.ContextMenu>
                                        <ContextMenu Background="White"
                                             BorderBrush="#E2E8F0"
                                             BorderThickness="1"
                                             Padding="6">

                                            <MenuItem Click="DeleteImageMenuItem_Click"
                                                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">

                                                <MenuItem.Template>
                                                    <ControlTemplate TargetType="MenuItem">
                                                        <Border x:Name="Border"
                                                        Background="Transparent"
                                                        CornerRadius="8"
                                                        Padding="14,10"
                                                        Margin="2">

                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="30"
                                                                    Height="30"
                                                                    Background="#FEE2E2"
                                                                    CornerRadius="6"
                                                                    Margin="0,0,10,0">

                                                                    <TextBlock Text="🗑"
                                                                        FontSize="15"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                                </Border>

                                                                <TextBlock Text="Delete Image"
                                                                    FontSize="16"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#B91C1C"
                                                                    VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="Border"
                                                                Property="Background"
                                                                Value="#FEF2F2"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </MenuItem.Template>

                                            </MenuItem>

                                        </ContextMenu>
                                    </Image.ContextMenu>
                                </Image>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>