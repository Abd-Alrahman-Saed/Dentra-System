<Window x:Class="Dental.UI.Views.AddPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Patient"
        Width="1120"
        Height="780"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Window.Resources>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderBrush" Value="#D8DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BigInputBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
            <Setter Property="Height" Value="94"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                <Button Content="←"
                        Width="45"
                        Height="40"
                        FontSize="30"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="GoBackButton_Click"/>
                <TextBlock Text="Add New Patient"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>
            </StackPanel>

            <!-- Top Cards -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Personal Info -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22">
                    <StackPanel>
                        <TextBlock Text="Personal Information"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0B73E8"
                                   Margin="0,0,0,20"/>

                        <Label Content="Full Name"/>
                        <TextBox x:Name="FullNameTextBox"
                                 Style="{StaticResource InputBox}"
                                 Margin="0,0,0,15"/>

                        <Label Content="Date of Birth"/>
                        <DatePicker x:Name="DateOfBirthPicker"
                                    Height="46"
                                    FontSize="16"
                                    Margin="0,0,0,15"/>

                        <Label Content="Gender"/>
                        <ComboBox x:Name="GenderComboBox"
                                  Height="46"
                                  FontSize="16"
                                  Margin="0,0,0,15"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Male"/>
                            <ComboBoxItem Content="Female"/>
                        </ComboBox>

                        <Label Content="Phone"/>
                        <TextBox x:Name="PhoneTextBox"
                                 Style="{StaticResource InputBox}"
                                 Margin="0,0,0,15"/>

                        <Label Content="Address"/>
                        <TextBox x:Name="AddressTextBox"
                                 Style="{StaticResource BigInputBox}"/>
                    </StackPanel>
                </Border>

                <!-- Medical History -->
                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22">
                    <StackPanel>
                        <TextBlock Text="Medical History"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0B73E8"
                                   Margin="0,0,0,20"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <CheckBox x:Name="DiabetesCheckBox" Content="Diabetes"/>
                                <CheckBox x:Name="HeartDiseaseCheckBox" Content="Heart Disease"/>
                                <CheckBox x:Name="AsthmaCheckBox" Content="Asthma"/>
                                <CheckBox x:Name="BleedingDisordersCheckBox" Content="Bleeding Disorders"/>
                                <CheckBox x:Name="HepatitisCheckBox" Content="Hepatitis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="HypertensionCheckBox" Content="Hypertension"/>
                                <CheckBox x:Name="AllergyCheckBox" Content="Allergy"/>
                                <CheckBox x:Name="PregnancyCheckBox" Content="Pregnancy"/>
                                <CheckBox x:Name="ThyroidDiseaseCheckBox" Content="Thyroid Disease"/>
                                <CheckBox x:Name="OtherMedicalCheckBox" Content="Other"/>
                            </StackPanel>
                        </Grid>

                        <Label Content="Other Conditions" Margin="0,20,0,0"/>
                        <TextBox x:Name="OtherConditionsTextBox"
                                 Style="{StaticResource BigInputBox}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Dental History -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="22"
                    Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Dental History"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#0B73E8"
                               Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <CheckBox x:Name="ToothSensitivityCheckBox" Content="Tooth Sensitivity"/>
                            <CheckBox x:Name="GumDiseaseCheckBox" Content="Gum Disease"/>
                            <CheckBox x:Name="JawPainCheckBox" Content="Jaw Pain / TMJ"/>
                            <CheckBox x:Name="TeethGrindingCheckBox" Content="Teeth Grinding (Bruxism)"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="PreviousDentalTreatmentCheckBox" Content="Previous Dental Treatment"/>
                            <CheckBox x:Name="OrthodonticTreatmentCheckBox" Content="Orthodontic Treatment"/>
                            <CheckBox x:Name="ExtractionCheckBox" Content="Extraction"/>
                            <CheckBox x:Name="OtherDentalCheckBox" Content="Other"/>
                        </StackPanel>
                    </Grid>

                    <Label Content="Dental Notes" Margin="0,20,0,0"/>
                    <TextBox x:Name="DentalNotesTextBox"
                             Style="{StaticResource BigInputBox}"/>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,28,0,0">
                <Button Content="Cancel"
                        Width="140"
                        Height="56"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#0B50B8"
                        Background="White"
                        BorderBrush="#CBD5E1"
                        Margin="0,0,10,0"
                        Click="GoBackButton_Click"/>

                <Button Content="Save Patient"
                        Width="240"
                        Height="56"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#0B73E8"
                        BorderBrush="#0B73E8"
                        Click="SavePatientButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>