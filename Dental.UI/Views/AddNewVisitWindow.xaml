<Window x:Class="Dental.UI.Views.AddNewVisitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Visit"
        Width="800"
        Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="White"
            CornerRadius="8"
            BorderBrush="#B8BEC8"
            BorderThickness="2"
            Padding="40,28">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Add New Visit"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#14213D"
                           VerticalAlignment="Center"/>

                <Button Content="×"
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        FontSize="30"
                        FontWeight="Light"
                        Foreground="#14213D"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1">

                <!-- Date + Status -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <!-- Date -->
                    <TextBlock Text="Date"
               Grid.Column="0"
               FontSize="16"
               FontWeight="SemiBold"
               Foreground="#14213D"
               VerticalAlignment="Center"/>

                    <DatePicker x:Name="VisitDatePicker"
                Grid.Column="1"
                Height="42"
                FontSize="16"
                SelectedDateFormat="Short"/>

                    <!-- Status -->
                    <TextBlock Text="    Tooth Status"
                        Grid.Column="3"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#14213D"
                        VerticalAlignment="Center"/>

                    <ComboBox x:Name="ToothStatusComboBox"
                        Grid.Column="4"
                        Height="42"
                        FontSize="15">

                        <ComboBoxItem Content="Healthy" Tag="Healthy"/>
                        <ComboBoxItem Content="With Notes" Tag="WithNotes"/>
                        <ComboBoxItem Content="Treated" Tag="Treated"/>
                        <ComboBoxItem Content="Problem" Tag="Problem"/>

                    </ComboBox>
                </Grid>

                <!-- Description -->
                <TextBlock Text="Description / Notes"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#14213D"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="DescriptionTextBox"
                         Height="82"
                         FontSize="15"
                         Padding="12"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         BorderBrush="#DDE3EA"
                         BorderThickness="2"
                         Margin="0,0,0,20"/>

                <!-- Clinical Photos Header -->
                <Grid Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Clinical Photos"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#14213D"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text=" 📷"
                                   FontSize="20"
                                   Foreground="#2F80ED"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="Upload"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#1A73E8"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="UploadClinicalPhotos_Click"/>
                </Grid>

                <!-- Clinical Photos Box -->
                <Border Height="74"
                        BorderBrush="#B9C5D6"
                        BorderThickness="2"
                        CornerRadius="6"
                        Margin="0,0,0,20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#B9C5D6"/>
                        </Style>
                    </Border.Style>

                    <Grid AllowDrop="True"
                          Drop="ClinicalDropArea_Drop"
                          MouseLeftButtonDown="ClinicalDropArea_MouseLeftButtonDown"
                          Cursor="Hand">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="📄"
                                       FontSize="26"
                                       Foreground="#2F80ED"
                                       Margin="0,0,14,0"/>

                            <TextBlock x:Name="ClinicalPhotosText"
                                       Text="Drag &amp; drop or click to upload"
                                       FontSize="16"
                                       Foreground="#3D4654"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- X-ray Images Header -->
                <Grid Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="X-ray Images"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#14213D"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text=" 📷"
                                   FontSize="20"
                                   Foreground="#2F80ED"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="Upload"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#1A73E8"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="UploadXrayImages_Click"/>
                </Grid>

                <!-- X-ray Box -->
                <Border Height="74"
                        BorderBrush="#B9C5D6"
                        BorderThickness="2"
                        CornerRadius="6"
                        Margin="0,0,0,26">

                    <Grid AllowDrop="True"
                          Drop="XrayDropArea_Drop"
                          MouseLeftButtonDown="XrayDropArea_MouseLeftButtonDown"
                          Cursor="Hand">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="📄"
                                       FontSize="26"
                                       Foreground="#2F80ED"
                                       Margin="0,0,14,0"/>

                            <TextBlock x:Name="XrayImagesText"
                                       Text="Drag &amp; drop or click to upload"
                                       FontSize="16"
                                       Foreground="#3D4654"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Buttons -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Cancel"
                            Height="50"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="#26364D"
                            Background="White"
                            BorderBrush="#DDE3EA"
                            BorderThickness="2"
                            Cursor="Hand"
                            Click="CancelButton_Click"/>

                    <Button Grid.Column="2"
                            Content="Save Visit"
                            Height="50"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#1A73E8"
                            BorderBrush="#1A73E8"
                            BorderThickness="2"
                            Cursor="Hand"
                            Click="SaveVisitButton_Click"/>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</Window>