<Window x:Class="Dental.UI.Views.PatientProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patient Profile"
        Width="1050"
        Height="760"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Window.Resources>

        <Style x:Key="ProfileTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,35,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="ToothButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="QuickActionItem" TargetType="Border">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuickIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="QuickText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Button Content="←"
                    Width="45"
                    Height="40"
                    FontSize="28"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BackButton_Click"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Border Width="86"
                        Height="86"
                        CornerRadius="43"
                        Background="#DBEAFE"
                        Margin="0,0,25,0">

                    <TextBlock x:Name="InitialsTextBlock"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FullNameTextBlock"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock x:Name="PatientDetailsTextBlock"
                               FontSize="16"
                               Foreground="#475569"
                               Margin="0,8,0,0"/>

                    <TextBlock x:Name="ContactTextBlock"
                               FontSize="16"
                               Foreground="#475569"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2"
                    Background="#F1F5F9"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Medical History"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,0,0,10"/>

                    <ItemsControl x:Name="MedicalHistoryItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="15"
                                           Foreground="#334155"
                                           Margin="0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tabs -->
        <Border Grid.Row="1"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                Margin="0,26,0,0">

            <StackPanel Orientation="Horizontal">
                <Button x:Name="OverviewTabButton"
                        Content="Overview"
                        Style="{StaticResource ProfileTabButton}"
                        Click="OverviewTabButton_Click"/>

                <Button x:Name="MedicalTabButton"
                        Content="Medical History"
                        Style="{StaticResource ProfileTabButton}"
                        Click="MedicalTabButton_Click"/>

                <Button x:Name="DentalTabButton"
                        Content="Dental History"
                        Style="{StaticResource ProfileTabButton}"
                        Click="DentalTabButton_Click"/>

                <Button x:Name="NotesTabButton"
                        Content="Notes"
                        Style="{StaticResource ProfileTabButton}"
                        Click="NotesTabButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="2" Margin="0,22,0,0">

            <!-- Overview Panel -->
            <Grid x:Name="OverviewPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <!-- Dental Chart -->
                <StackPanel>
                    <TextBlock Text="Dental Chart"
               FontSize="22"
               FontWeight="Bold"
               Foreground="#0F172A"
               Margin="0,0,0,20"/>

                    <Border BorderBrush="Black"
            BorderThickness="2"
            HorizontalAlignment="Center"
            Background="White">

                        <Grid Width="590">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Title -->
                            <Border Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Background="#E5E5E5"
                    BorderBrush="Black"
                    BorderThickness="0,0,0,2">
                                <TextBlock Text="Permanent Teeth"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Upper Labels -->
                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    BorderBrush="Black"
                                    BorderThickness="0,0,1,1">
                                    <TextBlock Text="Upper Left"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    BorderBrush="Black"
                                    BorderThickness="1,0,0,1">
                                <TextBlock Text="Upper Right"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                            </Border>

                            <!-- Upper Teeth -->
                            <Border Grid.Row="2"
                                Grid.Column="0"
                                BorderBrush="Black"
                                BorderThickness="0,0,1,2">
                                <UniformGrid Columns="8">
                                    <Button Content="8" Tag="16" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="7" Tag="15" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="6" Tag="14" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="5" Tag="13" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="4" Tag="12" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="3" Tag="11" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="2" Tag="10" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="1" Tag="9" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                </UniformGrid>
                            </Border>

                            <Border Grid.Row="2"
                                Grid.Column="1"
                                BorderBrush="Black"
                                BorderThickness="1,0,0,2">
                                <UniformGrid Columns="8">
                                    <Button Content="1" Tag="1" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="2" Tag="2" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="3" Tag="3" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="4" Tag="4" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="5" Tag="5" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="6" Tag="6" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="7" Tag="7" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="8" Tag="8" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                </UniformGrid>
                            </Border>

                            <!-- Lower Teeth -->
                            <Border Grid.Row="3"
                                Grid.Column="0"
                                BorderBrush="Black"
                                BorderThickness="0,0,1,1">
                                <UniformGrid Columns="8">
                                    <Button Content="8" Tag="24" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="7" Tag="23" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="6" Tag="22" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="5" Tag="21" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="4" Tag="20" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="3" Tag="19" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="2" Tag="18" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="1" Tag="17" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                </UniformGrid>
                            </Border>

                            <Border Grid.Row="3"
                                Grid.Column="1"
                                BorderBrush="Black"
                                BorderThickness="1,0,0,1">
                                <UniformGrid Columns="8">
                                    <Button Content="1" Tag="25" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="2" Tag="26" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="3" Tag="27" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="4" Tag="28" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="5" Tag="29" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="6" Tag="30" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="7" Tag="31" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                    <Button Content="8" Tag="32" Style="{StaticResource ToothButton}" Click="ToothButton_Click"/>
                                </UniformGrid>
                            </Border>

                            <!-- Lower Labels -->
                            <Border Grid.Row="4"
                                Grid.Column="0"
                                BorderBrush="Black"
                                BorderThickness="0,1,1,0">
                                <TextBlock Text="Lower Left"
                                    FontSize="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="4"
                                Grid.Column="1"
                                BorderBrush="Black"
                                BorderThickness="1,1,0,0">
                                
                                <TextBlock Text="Lower Right"
                                    FontSize="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                        </Grid>
                    </Border>

                    <TextBlock Text="Note: When adding a new visit, update the tooth status so its color in the Dental Chart changes automatically."
                        FontSize="14"
                        Foreground="#64748B"
                        TextWrapping="Wrap"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        MaxWidth="590"/>
                </StackPanel>

                <!-- Right Side -->
                <StackPanel Grid.Column="1">

                    <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Margin="0,0,0,20">

                        <StackPanel>
                            <TextBlock Text="Legend"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="○  Healthy" FontSize="16" Margin="0,6"/>
                            <TextBlock Text="●  With Notes" FontSize="16" Margin="0,6" Foreground="#F59E0B"/>
                            <TextBlock Text="●  Treated" FontSize="16" Margin="0,6" Foreground="#22C55E"/>
                            <TextBlock Text="●  Problem" FontSize="16" Margin="0,6" Foreground="#EF4444"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20">

                        <StackPanel>
                            <TextBlock Text="Quick Actions"
                                FontSize="18"
                                FontWeight="Bold"
                                Margin="0,0,0,15"/>

                            <!-- Add Note -->
                            <Border Style="{StaticResource QuickActionItem}"
                                    MouseLeftButtonUp="AddNote_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" Style="{StaticResource QuickIcon}"/>
                                    <TextBlock Text="Add Note" Style="{StaticResource QuickText}"/>
                                </StackPanel>
                            </Border>

                            <!-- Patient Notes -->
                            <Border Style="{StaticResource QuickActionItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📝" Style="{StaticResource QuickIcon}"/>
                                    <TextBlock Text="Patient Notes" Style="{StaticResource QuickText}"/>
                                </StackPanel>
                            </Border>

                            <!-- Export PDF -->
                            <Border Style="{StaticResource QuickActionItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" Style="{StaticResource QuickIcon}"/>
                                    <TextBlock Text="Export PDF" Style="{StaticResource QuickText}"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Medical History Panel -->
            <Border x:Name="MedicalHistoryPanel"
                    Visibility="Collapsed"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="28">

                <StackPanel>
                    <TextBlock Text="Medical History"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#0B73E8"
                               Margin="0,0,0,22"/>

                    <ItemsControl x:Name="MedicalTabItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="18"
                                           Foreground="#334155"
                                           Margin="0,8"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Dental History Panel -->
            <Border x:Name="DentalHistoryPanel"
                    Visibility="Collapsed"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="28">

                <StackPanel>
                    <TextBlock Text="Dental History"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#0B73E8"
                               Margin="0,0,0,22"/>

                    <ItemsControl x:Name="DentalHistoryItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="18"
                                           Foreground="#334155"
                                           Margin="0,8"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Notes Panel -->
            <Border x:Name="NotesPanel"
                    Visibility="Collapsed"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="28">

                <StackPanel>
                    <TextBlock Text="Notes"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#0B73E8"
                               Margin="0,0,0,22"/>

                    <TextBlock x:Name="PatientNotesTextBlock"
                               FontSize="18"
                               Foreground="#334155"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>