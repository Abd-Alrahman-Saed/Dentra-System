# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.cs text diff=csharp eol=crlf
*.xaml text eol=crlf
*.config text eol=crlf
*.json text eol=lf
*.sln text eol=crlf
*.slnx text eol=crlf
*.csproj text eol=crlf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary
*.dll binary
